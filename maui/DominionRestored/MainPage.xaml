<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:DominionRestored.Components"
             x:Class="DominionRestored.MainPage"
             BackgroundColor="#0B0B14">

    <BlazorWebView x:Name="blazorWebView"
                   HostPage="wwwroot/index.html"
                   BackgroundColor="#0B0B14"
                   BlazorWebViewInitializing="OnWebViewInitializing"
                   BlazorWebViewInitialized="OnWebViewInitialized">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type components:GameHost}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
